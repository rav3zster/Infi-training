# Supabase — publishable key only. NEVER put the service role/secret key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# DEV-ONLY one-time bootstrap credentials (Phase 2 silent auth).
# Replace with an EdgeFunctionCredentialSource before release so the
# permanent account password never ships in the application bundle.
VITE_DEV_EMAIL=you@example.com
VITE_DEV_PASSWORD=change-me
